<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application android:label="Roadprints Acceptance" tools:replace="android:label" android:allowBackup="false">
        <provider android:name="com.google.firebase.provider.FirebaseInitProvider" tools:node="remove" />
        <activity android:name=".OnboardingActivity" android:exported="false" tools:node="replace" />
        <activity android:name=".MilepostAcceptanceActivity" android:exported="false" />
        <activity-alias android:name=".AcceptanceLauncher" android:targetActivity=".MilepostAcceptanceActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
